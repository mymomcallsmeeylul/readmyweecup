# Copy to .env and fill in. Never commit .env.
#
# Without a key the app still runs: /api/read serves the reference readings in
# api/_readings.js and the reveal is labelled as a sample. That is enough to
# work on the design, the motion and the flow.

# Required for real readings. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional. The eye that looks into the cup, and the voice that writes the
# fortune. Both default to claude-sonnet-5.
# VISION_MODEL=claude-sonnet-5
# VOICE_MODEL=claude-sonnet-5

# Optional. Local dev server port. Defaults to 3000.
# PORT=3000
